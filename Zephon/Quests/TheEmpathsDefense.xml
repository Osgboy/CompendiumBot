<quest firstTurn="-1">
 	<conditions>
		<player>
			<faction name="ImperiousExonaut"/>
		</player>
	</conditions>
	<stages>
		<stage name="Intro">
			<options>
				<option name="TakeABreather" nextStage="TakeABreather"/>
				<option name="Ignore"/>
			</options>
		</stage>
		<stage name="TakeABreather">
			<options>
				<option name="BraceForImpact" nextStage="BraceForImpact"/>
			</options>
		</stage>
		<stage name="BraceForImpact" nextStageOnSuccess="BraceForImpactSuccess">
			<modifications>
				<nearCityTileSelector count="1" targetDistance="4">
					<conditions>
						<tile>
							<buildingSlots greater="0"/>
							<noCity/>
							<noFeature type="Bleed"/>
							<noFeatureCategory name="Cache"/>
							<noUnit/>
						</tile>
					</conditions>
				</nearCityTileSelector>
			</modifications>
			<objectives>
				<surviveInvasion name="SurviveInvasion" strength="8" waves="1">
					<attackers>
						<unit type="HeliosMissileTank" rankMin="0" rankMax="0" skipOverwatchOnNextTileEnter="1"/>
					</attackers>
				</surviveInvasion>
			</objectives>
		</stage>
		<stage name="BraceForImpactSuccess">
			<options>
				<option name="SacrificePawn" nextStage="SacrificePawn"/>
				<option name="SacrificeKnight" nextStage="SacrificeKnight"/>
			</options>
		</stage>
		<stage name="SacrificePawn"
				nextStageOnSuccess="SacrificePawnSuccess"
				nextStageOnFailure="SacrificePawnFailure">
			<modifications>
				<nearCityTileSelector count="1" targetDistance="8">
					<conditions>
						<tile>
							<buildingSlots greater="0"/>
							<noCity/>
							<noFeature type="Bleed"/>
							<noFeatureCategory name="Cache"/>
							<noUnit/>
						</tile>
					</conditions>
				</nearCityTileSelector>
				<tileModifiers>
					<modifier>
						<effects>
							<reveal/>
						</effects>
					</modifier>
				</tileModifiers>
			</modifications>
			<objectives>
				<visitTile name="SendHeroUnitToBePawn" turns="10">
					<unitConditions>
						<trait type="Hero"/>
					</unitConditions>		
					<unitModifiers>
						<modifier>
							<effects>
								<hitpoints max="1"/>
							</effects>
						</modifier>
					</unitModifiers>
				</visitTile>
			</objectives>
		</stage>
		<stage name="SacrificePawnFailure">
			<modifications>
				<playerSelector>
					<conditions>
						<player>
							<control/>
						</player>
					</conditions>
				</playerSelector>
				<playerModifiers>
					<modifier>
						<effects>
							<addTrait type="KolyasContempt" duration="5"/>
						</effects>
					</modifier>
				</playerModifiers>
			</modifications>
		</stage>
		<stage name="SacrificePawnSuccess">
			<options>
				<option name="StudyKolya" nextStage="StudyKolya"/>
				<option name="PlayYourGame" nextStage="PlayYourGame"/>
			</options>
		</stage>
		<stage name="SacrificeKnight" nextStageOnSuccess="SacrificeKnightSuccess">
			<modifications>
				<nearCityTileSelector count="1" targetDistance="4">
					<conditions>
						<tile>
							<buildingSlots greater="0"/>
							<noCity/>
							<noFeature type="Bleed"/>
							<noFeatureCategory name="Cache"/>
							<noUnit/>
						</tile>
					</conditions>
				</nearCityTileSelector>
			</modifications>
			<objectives>
				<surviveInvasion name="SurviveInvasion" strength="8" waves="2">
					<attackers>
						<unit type="AbkluthDragoon" count="1" rankMin="3" rankMax="3" skipOverwatchOnNextTileEnter="1"/>
						<unit type="AcrinMilitia" count="1" rankMin="3" rankMax="3" skipOverwatchOnNextTileEnter="1"/>
						<unit type="AnashimEnforcer" count="1" rankMin="3" rankMax="3" skipOverwatchOnNextTileEnter="1"/>
						<unit type="Hammerhead" count="1" rankMin="3" rankMax="3" skipOverwatchOnNextTileEnter="1"/>
					</attackers>
				</surviveInvasion>
			</objectives>
		</stage>
		<stage name="SacrificeKnightSuccess">
			<options>
				<option name="StudyKolya" nextStage="StudyKolya"/>
				<option name="PlayYourGame" nextStage="PlayYourGame"/>
			</options>
		</stage>
		<stage name="StudyKolya"
				nextStageOnSuccess="StudyKolyaSuccess">
			<modifications>
				<playerSelector>
					<conditions>
						<player>
							<control/>
						</player>
					</conditions>
				</playerSelector>
				<playerModifiers>
					<modifier>
						<effects>
							<addPlayerAction type="StudyKolya" charges="1"/>
						</effects>
					</modifier>
				</playerModifiers>
			</modifications>
			<objectives>
				<executePlayerOrder name="ExecuteOrder"
						orderName="StudyKolya"/>
			</objectives>
		</stage>
		<stage name="StudyKolyaSuccess">
			<options>
				<option name="TwoKnightDefense" nextStage="TwoKnightDefense"/>
			</options>
		</stage>
		<stage name="TwoKnightDefense" 
				nextStageOnFailure="TwoKnightDefenseFailure"
				nextStageOnSuccess="TwoKnightDefenseSuccess">
			<modifications>
				<nearCityTileSelector count="1" targetDistance="4">
					<conditions>
						<tile>
							<buildingSlots greater="0"/>
							<noCity/>
							<noFeature type="Bleed"/>
							<noFeatureCategory name="Cache"/>
							<noUnit/>
						</tile>
					</conditions>
				</nearCityTileSelector>
				<playerSelector>
					<conditions>
						<player>
							<control/>
						</player>
					</conditions>
				</playerSelector>
				<tileModifiers>
					<modifier>
						<effects>
							<addUnit type="KolyasFollowers" name="Units/KolyasFollowers" token="KolyasFollowers" count="1" skipOverwatchOnNextTileEnter="1"/>
						</effects>
					</modifier>
				</tileModifiers>
				<nearUnitTileSelector count="2" targetDistance="3">
					<conditions>
						<tile>
							<buildingSlots greater="0"/>
							<noCity/>
							<noFeature type="Bleed"/>
							<noFeatureCategory name="Cache"/>
							<noUnit/>
						</tile>
					</conditions>
					<unitConditions>
						<token name="KolyasFollowers"/>
					</unitConditions>
				</nearUnitTileSelector>			
			</modifications>
			<objectives>
				<surviveInvasion name="SurviveInvasion" strength="12" waves="2">
					<attackers>
						<unit type="VanquisherSiegeTank" count="1" rankMin="3" rankMax="3" skipOverwatchOnNextTileEnter="1"/>
						<unit type="Provocator" count="2" rankMin="3" rankMax="3" skipOverwatchOnNextTileEnter="1"/>
						<unit type="TH3Corsair" count="1" rankMin="3" rankMax="3" skipOverwatchOnNextTileEnter="1"/>
					</attackers>
				</surviveInvasion>
				<keepUnitAlive token="KolyasFollowers"/>
			</objectives>
		</stage>
		<stage name="TwoKnightDefenseFailure"/>
		<stage name="TwoKnightDefenseSuccess">
			<modifications>
				<unitSelector>
					<conditions>
						<unit>
							<token name="KolyasFollowers"/>
						</unit>
					</conditions>
				</unitSelector>
				<unitModifiers>
					<modifier>
						<effects>
							<removeUnit/>
						</effects>
					</modifier>
				</unitModifiers>
			</modifications>
			<options>
				<option name="ResetTheBoard" nextStage="ResetTheBoard"/>
				<option name="StabKolya" nextStage="StabKolya"/>
			</options>
		</stage>
		<stage name="ResetTheBoard">
			<modifications>
				<playerSelector>
					<conditions>
						<player>
							<control/>
						</player>
					</conditions>
				</playerSelector>
				<playerModifiers>
					<modifier>
						<effects>
							<addTrait type="PlayerOfGames"/>
							<unlockAchievement name="TheEmpathsDefense"/>
						</effects>
					</modifier>
				</playerModifiers>
			</modifications>
		</stage>
		<stage name="StabKolya">
			<modifications>
				<playerSelector>
					<conditions>
						<player>
							<control/>
						</player>
					</conditions>
				</playerSelector>
				<playerModifiers>
					<modifier>
						<effects>
							<addTrait type="ACurseOnBothYourHouses"/>
						</effects>
					</modifier>
				</playerModifiers>
			</modifications>
		</stage>
		<stage name="PlayYourGame" 
				nextStageOnFailure="PlayYourGameFailure"
				nextStageOnSuccess="PlayYourGameSuccess">
			<modifications>
				<nearCityTileSelector count="2" targetDistance="8">
					<conditions>
						<tile>
							<buildingSlots greater="0"/>
							<noCity/>
							<noFeature type="Bleed"/>
							<noFeatureCategory name="Cache"/>
							<noUnit/>
						</tile>
					</conditions>
				</nearCityTileSelector>
				<tileModifiers>
					<modifier visible="0">
						<effects>
							<reveal radius="1"/>
						</effects>
					</modifier>
				</tileModifiers>
			</modifications>			
			<objectives>
				<killCamp name="KillKolyasFollowers" turns="10">
					<boss type="KolyasFollowers" name="Units/KolyasFollowers" token="KolyasFollowers"/>
					<defenders>
						<unit type="AcrinMilitia" count="1" rankMin="3" rankMax="3" skipOverwatchOnNextTileEnter="1"/>
						<unit type="AnashimEnforcer" count="1" rankMin="3" rankMax="3" skipOverwatchOnNextTileEnter="1"/>
						<unit type="Hammerhead" count="1" rankMin="3" rankMax="3" skipOverwatchOnNextTileEnter="1"/>
					</defenders>
				</killCamp>
			</objectives>
		</stage>
		<stage name="PlayYourGameFailure">
			<modifications>
				<unitSelector>
					<conditions>
						<unit>
							<token name="KolyasFollowers"/>
						</unit>
					</conditions>
				</unitSelector>
				<unitModifiers>
					<modifier>
						<effects>
							<removeUnit/>
						</effects>
					</modifier>
				</unitModifiers>
			</modifications>
		</stage>
		<stage name="PlayYourGameSuccess">
			<options>
				<option name="OneLastGame" nextStage="OneLastGame"/>
				<option name="EndThis" nextStage="EndThis"/>
			</options>
		</stage>
		<stage name="OneLastGame" nextStageOnSuccess="OneLastGameSuccess">
			<modifications>	
				<nearCityTileSelector count="2" targetDistance="8">
					<conditions>
						<tile>
							<buildingSlots greater="0"/>
							<noCity/>
							<noFeature type="Bleed"/>
							<noFeatureCategory name="Cache"/>
							<noUnit/>
						</tile>
					</conditions>
				</nearCityTileSelector>
			</modifications>
			<objectives>
				<visitTile name="VisitRemnentsOfKolyasFollowers"/>
			</objectives>
		</stage>
		<stage name="OneLastGameSuccess">
			<modifications>
				<playerSelector>
					<conditions>
						<player>
							<control/>
						</player>
					</conditions>
				</playerSelector>
				<playerModifiers>
					<modifier>
						<effects>
							<addTrait type="QueensGambitAccepted"/>
						</effects>
					</modifier>
				</playerModifiers>
			</modifications>
		</stage>
		<stage name="EndThis" 
				nextStageOnSuccess="EndThisSuccess">
			<modifications>
				<nearCityTileSelector count="1" targetDistance="6">
					<conditions>
						<tile>
							<buildingSlots greater="0"/>
							<noCity/>
							<noFeature type="Bleed"/>
							<noFeatureCategory name="Cache"/>
							<noUnit/>
						</tile>
					</conditions>
				</nearCityTileSelector>
			</modifications>
			<objectives>
				<killCamp name="WipeOutKolyasFollowers">
					<defenders>
						<unit type="AcrinMilitia" count="1" rankMin="1" rankMax="1" skipOverwatchOnNextTileEnter="1"/>
						<unit type="AnashimEnforcer" count="1" rankMin="1" rankMax="1" skipOverwatchOnNextTileEnter="1"/>
						<unit type="AbkluthDragoon" count="1" rankMin="1" rankMax="1" skipOverwatchOnNextTileEnter="1"/>
					</defenders>
				</killCamp>
			</objectives>
		</stage>
		<stage name="EndThisSuccess">
			<modifications>
				<playerSelector>
					<conditions>
						<player>
							<control/>
						</player>
					</conditions>
				</playerSelector>
				<playerModifiers>
					<modifier>
						<effects>
							<addTrait type="QueensGambitDeclined"/>
						</effects>
					</modifier>
				</playerModifiers>
			</modifications>
		</stage>
	</stages>
</quest>
